// cmsoid.nv — the object identifiers of RFC 5652 and the algorithms it
// names, as named constants.  Each is the dotted text of the identifier,
// the form `cmsder.oid_text` answers and `cmsder.oid` takes.

// ── content types, RFC 5652 section 4 and RFC 5083 ───────────────────

// id-data.
pub const OID_DATA = "1.2.840.113549.1.7.1"
// id-signedData.
pub const OID_SIGNED_DATA = "1.2.840.113549.1.7.2"
// id-envelopedData.
pub const OID_ENVELOPED_DATA = "1.2.840.113549.1.7.3"
// id-digestedData.
pub const OID_DIGESTED_DATA = "1.2.840.113549.1.7.5"
// id-encryptedData.
pub const OID_ENCRYPTED_DATA = "1.2.840.113549.1.7.6"
// id-ct-authData (AuthenticatedData), stated as not implemented.
pub const OID_AUTHENTICATED_DATA = "1.2.840.113549.1.9.16.1.2"
// id-ct-authEnvelopedData, RFC 5083.
pub const OID_AUTH_ENVELOPED_DATA = "1.2.840.113549.1.9.16.1.23"

// ── attributes, RFC 5652 section 11 ──────────────────────────────────

// id-contentType.
pub const OID_CONTENT_TYPE = "1.2.840.113549.1.9.3"
// id-messageDigest.
pub const OID_MESSAGE_DIGEST = "1.2.840.113549.1.9.4"
// id-signingTime.
pub const OID_SIGNING_TIME = "1.2.840.113549.1.9.5"
// id-countersignature, stated as not implemented.
pub const OID_COUNTERSIGNATURE = "1.2.840.113549.1.9.6"

// ── digest algorithms ────────────────────────────────────────────────

// id-sha1.
pub const OID_SHA1 = "1.3.14.3.2.26"
// id-sha256.
pub const OID_SHA256 = "2.16.840.1.101.3.4.2.1"
// id-sha384.
pub const OID_SHA384 = "2.16.840.1.101.3.4.2.2"
// id-sha512.
pub const OID_SHA512 = "2.16.840.1.101.3.4.2.3"

// ── signature algorithms ─────────────────────────────────────────────

// rsaEncryption, RFC 3370: RSASSA-PKCS1-v1_5 with the digest the
// SignerInfo names.
pub const OID_RSA_ENCRYPTION = "1.2.840.113549.1.1.1"
// sha1WithRSAEncryption.
pub const OID_SHA1_WITH_RSA = "1.2.840.113549.1.1.5"
