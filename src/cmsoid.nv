// sha512WithRSAEncryption.
pub const OID_SHA512_WITH_RSA = "1.2.840.113549.1.1.13"
// id-RSASSA-PSS, RFC 4056.
pub const OID_RSASSA_PSS = "1.2.840.113549.1.1.10"
// id-mgf1.
pub const OID_MGF1 = "1.2.840.113549.1.1.8"
// ecdsa-with-SHA256, RFC 5753.
pub const OID_ECDSA_SHA256 = "1.2.840.10045.4.3.2"
// ecdsa-with-SHA384.
pub const OID_ECDSA_SHA384 = "1.2.840.10045.4.3.3"
