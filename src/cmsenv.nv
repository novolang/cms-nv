// cmsenv.nv — EnvelopedData (RFC 5652 section 6) and AuthEnvelopedData
// (RFC 5083, with AES-GCM as RFC 5084 defines it).
//
// A message has a content encrypted under a content encryption key (CEK)
// and, for each recipient, that key in a form only the recipient can open.
// This package reads every kind of RecipientInfo and opens two of them:
//
//   KEKRecipientInfo       the CEK wrapped by a key the two sides share,
//                          RFC 3394 AES key wrap (section 6.2.3)
//   PasswordRecipientInfo  the CEK wrapped by a key derived from a
//                          password with PBKDF2, in the CBC key wrap of
//                          RFC 3211 (section 6.2.4)
//
// KeyTransRecipientInfo (RSA) and KeyAgreeRecipientInfo (ECDH) are read
// and their identifiers, algorithms and encrypted keys are available, and
// opening them is stated as not implemented: rsa-nv has no private-key
// operation, and the ECDH recipient of RFC 5753 is not written.  A message
// with an RSA recipient and a KEK recipient opens through the KEK.
//
// Nothing here draws random numbers.  The CEK, the IV, the nonce, the
// PBKDF2 salt and the padding of the RFC 3211 wrap are the caller's, and a
// CEK, an IV or a nonce must be fresh for every message.

use std.bytes
use std.list
use pbkdf2prf
use pbkdf2params
use pbkdf2kdf
use cmserr
use cmsoid
use cmsder
use cmscrypto
use cmsinfo

// One RecipientInfo.
pub struct CmsRecipient
    // 0 KeyTransRecipientInfo, 1 KeyAgreeRecipientInfo, 2
    // KEKRecipientInfo, 3 PasswordRecipientInfo, 4 OtherRecipientInfo.
    kind: Int
    // The KEK identifier of a KEKRecipientInfo, or the subject key
    // identifier of a KeyTransRecipientInfo that names its key that way.
    key_id: Bytes
    // The issuer (a Name, as encoded) and the serial number (the INTEGER's
    // content) of a KeyTransRecipientInfo that names a certificate.
    issuer: Bytes
    serial: Bytes
    // The key encryption algorithm's object identifier and parameters.
    alg: Str
    alg_params: ?DerNode
    // The key derivation algorithm and parameters of a
    // PasswordRecipientInfo.
    kdf: Str
    kdf_params: ?DerNode
    encrypted_key: Bytes

// An EnvelopedData.
pub struct CmsEnveloped
    version: Int
    recipients: [CmsRecipient]
    eci: CmsEci

// An AuthEnvelopedData with AES-GCM: the ciphertext is in `eci` and the
// authentication tag is `mac`.
pub struct CmsAuthEnveloped
    version: Int
    recipients: [CmsRecipient]
    eci: CmsEci
    mac: Bytes

fn nothing() -> Bytes
    bytes.zeros(0)

fn blank(kind: Int) -> CmsRecipient
    CmsRecipient { kind: kind, key_id: nothing(), issuer: nothing(), serial: nothing(), alg: "",
                   alg_params: None, kdf: "", kdf_params: None, encrypted_key: nothing() }

fn key_alg(n: DerNode) -> Result<DerAlg, CmsError>
    cmsder.alg_of(n)

fn ktri_read(n: DerNode) -> Result<CmsRecipient, CmsError>
    let kids = cmsder.children(n)!
    let rid = cmsder.member(kids, 1, "the recipient identifier")!
    let alg = key_alg(cmsder.member(kids, 2, "the key encryption algorithm")!)!
    let ek = cmsder.octets(cmsder.member(kids, 3, "the encrypted key")!)!
    if cmsder.is_universal(rid, 16)
        let parts = cmsder.children(rid)!
        let issuer = cmsder.raw(cmsder.member(parts, 0, "the issuer")!)
        let serial = cmsder.content(cmsder.member(parts, 1, "the serial number")!)
        return Ok(CmsRecipient { kind: 0, key_id: nothing(), issuer: issuer, serial: serial, alg: alg.oid,
                                 alg_params: alg.params, kdf: "", kdf_params: None, encrypted_key: ek })
    if cmsder.is_context(rid, 0)
        return Ok(CmsRecipient { kind: 0, key_id: cmsder.content(rid), issuer: nothing(), serial: nothing(),
                                 alg: alg.oid, alg_params: alg.params, kdf: "", kdf_params: None, encrypted_key: ek })
    Err(CmsMalformed("the recipient identifier"))

fn kekri_read(n: DerNode) -> Result<CmsRecipient, CmsError>
    let kids = cmsder.children(n)!
    let kekid = cmsder.children(cmsder.member(kids, 1, "the KEK identifier")!)!
    let id = cmsder.octets(cmsder.member(kekid, 0, "the key identifier")!)!
    let alg = key_alg(cmsder.member(kids, 2, "the key encryption algorithm")!)!
    let ek = cmsder.octets(cmsder.member(kids, 3, "the encrypted key")!)!
    Ok(CmsRecipient { kind: 2, key_id: id, issuer: nothing(), serial: nothing(), alg: alg.oid,
                      alg_params: alg.params, kdf: "", kdf_params: None, encrypted_key: ek })

fn pwri_read(n: DerNode) -> Result<CmsRecipient, CmsError>
    let kids = cmsder.children(n)!
    var at = 1
    var kdf = ""
    var kdf_params: ?DerNode = None
    let first = cmsder.member(kids, at, "the key derivation algorithm")!
    if cmsder.is_context(first, 0)
        let d = cmsder.children(first)!
        kdf = cmsder.oid_text(cmsder.member(d, 0, "the key derivation algorithm")!)!
        if list.len(d) > 1
            kdf_params = Some(d[1])
        at = 2
    let alg = key_alg(cmsder.member(kids, at, "the key encryption algorithm")!)!
    let ek = cmsder.octets(cmsder.member(kids, at + 1, "the encrypted key")!)!
    Ok(CmsRecipient { kind: 3, key_id: nothing(), issuer: nothing(), serial: nothing(), alg: alg.oid,
                      alg_params: alg.params, kdf: kdf, kdf_params: kdf_params, encrypted_key: ek })

fn recipient_read(n: DerNode) -> Result<CmsRecipient, CmsError>
    if cmsder.is_universal(n, 16)
        return ktri_read(n)
    if cmsder.is_context(n, 1)
        return Ok(blank(1))
    if cmsder.is_context(n, 2)
        return kekri_read(n)
    if cmsder.is_context(n, 3)
        return pwri_read(n)
    if cmsder.is_context(n, 4)
        return Ok(blank(4))
    Err(CmsMalformed("a RecipientInfo"))

fn recipients_read(set: DerNode) -> Result<[CmsRecipient], CmsError>
    if not cmsder.is_universal(set, 17)
        return Err(CmsMalformed("the recipient infos are a SET"))
    var out: [CmsRecipient] = []
    for k in cmsder.children(set)!
        let r = recipient_read(k)!
        list.push(out, r)
    if list.len(out) == 0
        return Err(CmsMalformed("a message has at least one recipient"))
    Ok(out)

// The body of a ContentInfo of this type, as the members of its SEQUENCE
// after the version, with an originatorInfo skipped.
fn body_of(src: Bytes, want: Str) -> Result<[DerNode], CmsError>
    let info = cmsinfo.read(src)!
    let sd = cmsder.expect(cmsinfo.content_of(info, want)!, 16, "the message")!
    cmsder.children(sd)

// Read a ContentInfo of type enveloped-data.
pub fn enveloped_read(src: Bytes) -> Result<CmsEnveloped, CmsError> []
    let kids = body_of(src, OID_ENVELOPED_DATA)!
    let v = cmsder.int_value(cmsder.member(kids, 0, "the version")!)!
    var at = 1
    if cmsder.is_context(cmsder.member(kids, 1, "the recipient infos")!, 0)
        at = 2
    let rs = recipients_read(cmsder.member(kids, at, "the recipient infos")!)!
    let eci = cmsinfo.eci_read(cmsder.member(kids, at + 1, "the EncryptedContentInfo")!)!
    Ok(CmsEnveloped { version: v, recipients: rs, eci: eci })

// Read a ContentInfo of type auth-enveloped-data.  Authenticated
// attributes are stated as not implemented.
pub fn auth_read(src: Bytes) -> Result<CmsAuthEnveloped, CmsError> []
    let kids = body_of(src, OID_AUTH_ENVELOPED_DATA)!
    let v = cmsder.int_value(cmsder.member(kids, 0, "the version")!)!
    var at = 1
    if cmsder.is_context(cmsder.member(kids, 1, "the recipient infos")!, 0)
        at = 2
    let rs = recipients_read(cmsder.member(kids, at, "the recipient infos")!)!
    let eci = cmsinfo.eci_read(cmsder.member(kids, at + 1, "the EncryptedContentInfo")!)!
    var next = at + 2
    if list.len(kids) > next and cmsder.is_context(kids[next], 1)
        return Err(CmsNotImplemented("authenticated attributes of AuthEnvelopedData"))
    let mac = cmsder.octets(cmsder.member(kids, next, "the MAC")!)!
    Ok(CmsAuthEnveloped { version: v, recipients: rs, eci: eci, mac: mac })

// ── opening a recipient ──────────────────────────────────────────────

// Why no recipient opened: the first kind this package cannot open that
// the message holds, or the plain absence of a match.
fn nothing_opens(rs: [CmsRecipient], what: Str) -> CmsError
    for r in rs
        if r.kind == 0
            return CmsNotImplemented("KeyTransRecipientInfo: rsa-nv has no RSA decryption, and no ${what} matched")
        if r.kind == 1
            return CmsNotImplemented("KeyAgreeRecipientInfo: the ECDH recipient of RFC 5753 is not implemented, and no ${what} matched")
    CmsNoMatch(what)

fn kek_len_of(alg: Str) -> Int
    match alg
        "2.16.840.1.101.3.4.1.5"  => 16
        "2.16.840.1.101.3.4.1.25" => 24
        "2.16.840.1.101.3.4.1.45" => 32
        _                         => 0

// The CEK from the KEKRecipientInfo whose key identifier is `key_id`.
pub fn cek_from_kek(rs: [CmsRecipient], key_id: Bytes, kek: Bytes) -> Result<Bytes, CmsError> []
    for r in rs
        if r.kind == 2 and bytes.to_hex(r.key_id) == bytes.to_hex(key_id)
            if kek_len_of(r.alg) == 0
                return Err(CmsUnsupportedAlg(r.alg))
            if bytes.len(kek) != kek_len_of(r.alg)
                return Err(CmsBadKey("the key for ${r.alg} is ${kek_len_of(r.alg)} bytes"))
            return cmscrypto.kw_unwrap(kek, r.encrypted_key)
    Err(nothing_opens(rs, "KEKRecipientInfo with the key identifier"))

fn prf_of(oid: Str) -> Result<Pbkdf2Prf, CmsError>
    match oid
        "1.2.840.113549.2.7"  => Ok(Pbkdf2HmacSha1)
        "1.2.840.113549.2.9"  => Ok(Pbkdf2HmacSha256)
        "1.2.840.113549.2.11" => Ok(Pbkdf2HmacSha512)
        _                     => Err(CmsUnsupportedAlg(oid))

// The key-encryption key a PasswordRecipientInfo derives: PBKDF2 over the
// password with the salt, count and PRF of its parameters, as long as the
// key of the cipher its key encryption algorithm names.  The count is the
// sender's, so the caller bounds it with `max_iterations`.
fn password_kek(r: CmsRecipient, password: Bytes, max_iterations: Int, klen: Int) -> Result<Bytes, CmsError>
    if r.kdf != OID_PBKDF2
        return Err(CmsUnsupportedAlg(r.kdf))
    match r.kdf_params
        None    => Err(CmsMalformed("the PBKDF2 parameters"))
        Some(p) =>
            let kids = cmsder.children(p)!
            let salt = cmsder.octets(cmsder.member(kids, 0, "the salt")!)!
            let count = cmsder.int_value(cmsder.member(kids, 1, "the iteration count")!)!
            var prf = Pbkdf2HmacSha1
            var at = 2
            if list.len(kids) > at and cmsder.is_universal(kids[at], 2)
                at = 3
            if list.len(kids) > at
                prf = prf_of(cmsder.alg_of(kids[at])!.oid)!
            if count < 1 or count > max_iterations
                return Err(CmsBadKey("the iteration count is ${count}, the limit is ${max_iterations}"))
            match pbkdf2params.allowing_below_floor(prf, count, klen)
                // cov: skip — the count is positive by the check above and the length is one the cap allows
                Err(e) => Err(CmsBadKey(e.message()))
                Ok(params) =>
                    match pbkdf2kdf.derive(params, password, salt)
                        // cov: skip — `derive` refuses only parameters, which `allowing_below_floor` has accepted
                        Err(e) => Err(CmsBadKey(e.message()))
                        Ok(k)  => Ok(k)

// The CEK from the first PasswordRecipientInfo the password opens.
pub fn cek_from_password(rs: [CmsRecipient], password: Bytes, max_iterations: Int) -> Result<Bytes, CmsError> []
    for r in rs
        if r.kind == 3
            if r.alg != OID_PWRI_KEK
                return Err(CmsUnsupportedAlg(r.alg))
            match r.alg_params
                None    => return Err(CmsMalformed("the key encryption parameters"))
                Some(p) =>
                    let inner = cmsder.alg_of(p)!
                    let klen = cmsinfo.enc_key_len(inner.oid)
                    if klen == 0
                        return Err(CmsUnsupportedAlg(inner.oid))
                    match inner.params
                        None     => return Err(CmsMalformed("the wrapping IV"))
                        Some(ivn) =>
                            let iv = cmsder.octets(ivn)!
                            let kek = password_kek(r, password, max_iterations, klen)!
                            return cmscrypto.pwri_unwrap(kek, iv, r.encrypted_key)
    Err(nothing_opens(rs, "PasswordRecipientInfo"))

// ── opening a message ────────────────────────────────────────────────

// Decrypt an EnvelopedData with the CEK itself.
pub fn decrypt_with_cek(msg: CmsEnveloped, cek: Bytes, detached: ?Bytes) -> Result<Bytes, CmsError> []
    cmsinfo.eci_decrypt(msg.eci, cek, detached)

// Decrypt with the KEK of the KEKRecipientInfo that names `key_id`.
pub fn decrypt_with_kek(msg: CmsEnveloped, key_id: Bytes, kek: Bytes, detached: ?Bytes) -> Result<Bytes, CmsError> []
    let cek = cek_from_kek(msg.recipients, key_id, kek)!
    cmsinfo.eci_decrypt(msg.eci, cek, detached)

// Decrypt with a password.
pub fn decrypt_with_password(msg: CmsEnveloped, password: Bytes, max_iterations: Int,
                             detached: ?Bytes) -> Result<Bytes, CmsError> []
    let cek = cek_from_password(msg.recipients, password, max_iterations)!
    cmsinfo.eci_decrypt(msg.eci, cek, detached)

// Decrypt an AuthEnvelopedData with the CEK itself.  The tag is checked
// before any plaintext is produced.
pub fn auth_decrypt_with_cek(a: CmsAuthEnveloped, cek: Bytes, detached: ?Bytes) -> Result<Bytes, CmsError> []
    if not cmsinfo.is_gcm(a.eci.enc_alg)
        return Err(CmsUnsupportedAlg(a.eci.enc_alg))
    if bytes.len(cek) != cmsinfo.enc_key_len(a.eci.enc_alg)
        return Err(CmsBadKey("the content key of ${a.eci.enc_alg} is ${cmsinfo.enc_key_len(a.eci.enc_alg)} bytes"))
    if a.eci.icv_len != bytes.len(a.mac)
        return Err(CmsMalformed("the MAC is ${bytes.len(a.mac)} bytes and the parameters say ${a.eci.icv_len}"))
    var ct = bytes.zeros(0)
    match a.eci.encrypted
        Some(c) =>
            if detached != None
                return Err(CmsDetachedConflict)
            ct = bytes.clone(c)
        None    =>
            match detached
                None    => return Err(CmsNoContent)
                Some(x) => ct = bytes.clone(x)
    cmscrypto.gcm_open(cek, a.eci.iv, bytes.zeros(0), ct, a.mac)

// Decrypt an AuthEnvelopedData with a KEK.
pub fn auth_decrypt_with_kek(a: CmsAuthEnveloped, key_id: Bytes, kek: Bytes, detached: ?Bytes) -> Result<Bytes, CmsError> []
    let cek = cek_from_kek(a.recipients, key_id, kek)!
    auth_decrypt_with_cek(a, cek, detached)

// Decrypt an AuthEnvelopedData with a password.
pub fn auth_decrypt_with_password(a: CmsAuthEnveloped, password: Bytes, max_iterations: Int,
                                  detached: ?Bytes) -> Result<Bytes, CmsError> []
    let cek = cek_from_password(a.recipients, password, max_iterations)!
    auth_decrypt_with_cek(a, cek, detached)

// ── writing ──────────────────────────────────────────────────────────

// A recipient that holds a key shared with the sender.
pub struct CmsKekTarget
    key_id: Bytes
    kek: Bytes

// A recipient that holds a password.  `salt`, `iterations`, the 16-byte
// `iv` of the key wrap and its `padding` are the sender's; `prf` is the
// object identifier of hmacWithSHA1, hmacWithSHA256 or hmacWithSHA512.
// The key wrap is under AES-CBC with a key as long as `wrap_alg`'s.
pub struct CmsPasswordTarget
    password: Bytes
    salt: Bytes
    iterations: Int
    prf: Str
    wrap_alg: Str
    iv: Bytes
    padding: Bytes

fn wrap_oid(len: Int) -> Result<Str, CmsError>
    if len == 16
        return Ok(OID_AES128_WRAP)
    if len == 24
        return Ok(OID_AES192_WRAP)
    if len == 32
        return Ok(OID_AES256_WRAP)
    Err(CmsBadKey("a KEK is 16, 24 or 32 bytes"))

fn kekri_write(t: CmsKekTarget, cek: Bytes) -> Result<Bytes, CmsError>
    let alg = wrap_oid(bytes.len(t.kek))!
    let wrapped = cmscrypto.kw_wrap(t.kek, cek)!
    Ok(cmsder.ctx(2, bytes.concat([cmsder.int_u(4), cmsder.seq([cmsder.oct(t.key_id)]),
                                   cmsder.alg_id(alg, None)!, cmsder.oct(wrapped)])))

fn pwri_write(t: CmsPasswordTarget, cek: Bytes) -> Result<Bytes, CmsError>
    let klen = cmsinfo.enc_key_len(t.wrap_alg)
    if klen == 0 or cmsinfo.is_gcm(t.wrap_alg)
        return Err(CmsUnsupportedAlg(t.wrap_alg))
    let prf = prf_of(t.prf)!
    if bytes.len(t.salt) < 8
        return Err(CmsBadKey("the salt is at least 8 bytes"))
    match pbkdf2params.allowing_below_floor(prf, t.iterations, klen)
        Err(e) => Err(CmsBadKey(e.message()))
        Ok(params) =>
            match pbkdf2kdf.derive(params, t.password, t.salt)
                Err(e) => Err(CmsBadKey(e.message()))
                Ok(kek) =>
                    let wrapped = cmscrypto.pwri_wrap(kek, t.iv, cek, t.padding)!
                    let pbkdf2 = cmsder.seq([cmsder.oct(t.salt), cmsder.int_u(t.iterations), cmsder.alg_id(t.prf, Some(cmsder.null_value()))!])
                    let kdf = cmsder.ctx(0, bytes.concat([cmsder.oid(OID_PBKDF2)!, pbkdf2]))
                    let inner = cmsder.alg_id(t.wrap_alg, Some(cmsder.oct(t.iv)))!
                    Ok(cmsder.ctx(3, bytes.concat([cmsder.int_u(0), kdf, cmsder.alg_id(OID_PWRI_KEK, Some(inner))!, cmsder.oct(wrapped)])))

fn recipients_write(keks: [CmsKekTarget], pws: [CmsPasswordTarget], cek: Bytes) -> Result<Bytes, CmsError>
    if list.len(keks) + list.len(pws) == 0
        return Err(CmsMalformed("a message has at least one recipient"))
    var parts: [Bytes] = []
    for t in keks
        let r = kekri_write(t, cek)!
        list.push(parts, bytes.clone(r))
    for t in pws
        let r = pwri_write(t, cek)!
        list.push(parts, bytes.clone(r))
    Ok(cmsder.set_of(parts))

// A ContentInfo of type enveloped-data: `plain` encrypted under `cek` with
// AES-CBC, and the CEK wrapped for every target.  The version is 2 for
// KEK recipients and 3 when a password recipient is present.
pub fn enveloped_write(enc_alg: Str, cek: Bytes, iv: Bytes, plain: Bytes, keks: [CmsKekTarget],
                       pws: [CmsPasswordTarget], detach: Bool) -> Result<Bytes, CmsError> []
    let rs = recipients_write(keks, pws, cek)!
    let eci = cmsinfo.eci_write(enc_alg, cek, iv, plain, detach)!
    var version = 2
    if list.len(pws) > 0
        version = 3
    cmsinfo.write(OID_ENVELOPED_DATA, cmsder.seq([cmsder.int_u(version), rs, eci]))

// A ContentInfo of type auth-enveloped-data with AES-GCM and a 16-byte tag.
pub fn auth_write(enc_alg: Str, cek: Bytes, nonce: Bytes, plain: Bytes, keks: [CmsKekTarget],
                  pws: [CmsPasswordTarget], detach: Bool) -> Result<Bytes, CmsError> []
    if not cmsinfo.is_gcm(enc_alg)
        return Err(CmsUnsupportedAlg(enc_alg))
    if bytes.len(cek) != cmsinfo.enc_key_len(enc_alg)
        return Err(CmsBadKey("the content key of ${enc_alg} is ${cmsinfo.enc_key_len(enc_alg)} bytes"))
    let rs = recipients_write(keks, pws, cek)!
    let sealed = cmscrypto.gcm_seal(cek, nonce, bytes.zeros(0), plain)!
    let params = cmsder.seq([cmsder.oct(nonce), cmsder.int_u(16)])
    var parts = [cmsder.oid(OID_DATA)!, cmsder.alg_id(enc_alg, Some(params))!]
    if not detach
        list.push(parts, cmsder.ctx_prim(0, sealed.ciphertext))
    let eci = cmsder.seq(parts)
    cmsinfo.write(OID_AUTH_ENVELOPED_DATA, cmsder.seq([cmsder.int_u(0), rs, eci, cmsder.oct(sealed.tag)]))
