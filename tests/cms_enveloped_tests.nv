// cms_enveloped_tests.nv — EnvelopedData and AuthEnvelopedData.
//
// The messages below were made once with OpenSSL 3.0.13 (the commands are
// in tests/generate/gen_cms_vectors.sh) and are checked in as hex.  Each
// carries a KeyTransRecipientInfo for an RSA key, which this package reads
// and cannot open, and a recipient it can: a KEKRecipientInfo whose key is
// 000102..0f with the identifier "KKKK", a PasswordRecipientInfo whose
// password is "correct horse", or, for the AuthEnvelopedData, a KEK with
// the identifier "KK".  The text OpenSSL encrypts is S/MIME-canonical, so
// the plaintext ends in CRLF.

use std.test
use std.bytes
use std.list
use cmserr
use cmsoid
use cmsder
use cmsinfo
use cmsenv

fn said<T>(r: Result<T, CmsError>) -> Str
    match r
        Ok(_)  => "ok"
        Err(e) => e.message()

fn h(s: Str) -> Bytes
    bytes.from_hex(s) ?? bytes.zeros(0)

fn hex(b: Bytes) -> Str
    bytes.to_hex(b)

fn text_of(r: Result<Bytes, CmsError>) -> Str
    match r
        Ok(b)  => bytes.to_str(b)
        Err(e) => e.message()

fn kek() -> Bytes
    h("000102030405060708090a0b0c0d0e0f")

fn env_of(hexed: Str) -> CmsEnveloped
    match cmsenv.enveloped_read(h(hexed))
        Ok(e)  => e
        Err(e) =>
            test.fail(e.message())
            CmsEnveloped { version: 0, recipients: [], eci: CmsEci { content_type: "", enc_alg: "", iv: bytes.zeros(0), icv_len: 0, encrypted: None } }

fn auth_of(hexed: Str) -> CmsAuthEnveloped
    match cmsenv.auth_read(h(hexed))
        Ok(e)  => e
        Err(e) =>
            test.fail(e.message())
            CmsAuthEnveloped { version: 0, recipients: [], eci: CmsEci { content_type: "", enc_alg: "", iv: bytes.zeros(0), icv_len: 0, encrypted: None }, mac: bytes.zeros(0) }

fn counter(n: Int, seed: Int) -> Bytes
    var b = bytes.zeros(n)
    for i in 0..n
        bytes.set_u8(b, i, i * 3 + seed)
    b

fn rsa_pkcs1() -> Str
    ""

fn rsa_pss() -> Str
    ""

fn ec() -> Str
    ""

fn ec_detached() -> Str
    ""

fn certs_only() -> Str
    ""

fn kek128() -> Str
    ""

fn pwri() -> Str
    ""

fn authenv() -> Str
    ""

fn encdata() -> Str
    "306006092a864886f70d010706a0533051020100304c06092a864886f70d010701301d060960864801650304012a041088a5713cdbdb2b15afa25b35a2101aaf8020f8ae00f2c2e07aec983ebb7da869756ae7072ca56d0577bfca1ddf6f12b5cac0"

fn digested() -> Str
    "306506092a864886f70d010705a0583056020100300b0609608648016503040201302206092a864886f70d010701a015041348656c6c6f2c20434d5320776f726c642e0d0a04206761903d7fd37a026b6c62847957cfb5a72d75dbeab1f05f2839e941bd400e3b"

fn cert_rsa() -> Str
    ""

fn cert_ec() -> Str
    ""

@test
fn test_openssl_kek_recipient() [io]
    let m = env_of(kek128())
    test.assert_eq(m.version, 2)
    test.assert_eq(list.len(m.recipients), 2)
    test.case("the RSA recipient is read: its certificate is named by issuer and serial")
    let rsa = m.recipients[0]
    test.assert_eq(rsa.kind, 0)
    test.assert_eq_str(rsa.alg, OID_RSA_ENCRYPTION)
    test.assert_eq(bytes.len(rsa.encrypted_key), 256)
    test.assert_eq(bytes.len(rsa.serial), 20)
    test.assert_eq(bytes.len(rsa.key_id), 0)
    test.case("the KEK recipient opens the message")
    let k = m.recipients[1]
    test.assert_eq(k.kind, 2)
    test.assert_eq_str(k.alg, OID_AES128_WRAP)
    test.assert_eq_str(bytes.to_str(k.key_id), "KKKK")
    test.assert_eq_str(text_of(cmsenv.decrypt_with_kek(m, bytes.from_str("KKKK"), kek(), None)), "Hello, CMS world.\r\n")
    test.case("the unwrapped key opens it directly")
    match cmsenv.cek_from_kek(m.recipients, bytes.from_str("KKKK"), kek())
        Err(e)  => test.fail(e.message())
        Ok(cek) => test.assert_eq_str(text_of(cmsenv.decrypt_with_cek(m, cek, None)), "Hello, CMS world.\r\n")
    test.case("what goes wrong")
    test.assert_eq_str(said(cmsenv.decrypt_with_kek(m, bytes.from_str("KKKK"), h("ff0102030405060708090a0b0c0d0e0f"), None)),
        "cms: the signature, digest or tag did not verify")
    test.assert_eq_str(said(cmsenv.decrypt_with_kek(m, bytes.from_str("KKKK"), h("0001"), None)),
        "cms: unusable key: the key for 2.16.840.1.101.3.4.1.5 is 16 bytes")
    test.assert_eq_str(said(cmsenv.decrypt_with_kek(m, bytes.from_str("other"), kek(), None)),
        "cms: not implemented: KeyTransRecipientInfo: rsa-nv has no RSA decryption, and no KEKRecipientInfo with the key identifier matched")
    test.assert_eq_str(said(cmsenv.decrypt_with_password(m, bytes.from_str("pw"), 5000, None)),
        "cms: not implemented: KeyTransRecipientInfo: rsa-nv has no RSA decryption, and no PasswordRecipientInfo matched")
    test.assert_eq_str(said(cmsenv.decrypt_with_kek(m, bytes.from_str("KKKK"), kek(), Some(h("00")))),
        "cms: content was supplied for a message that carries its own")
    test.assert_eq_str(said(cmsenv.decrypt_with_cek(m, h("00"), None)),
        "cms: unusable key: the content key of 2.16.840.1.101.3.4.1.2 is 16 bytes")

@test
fn test_openssl_password_recipient() [io]
    let m = env_of(pwri())
    test.assert_eq(m.version, 3)
    let p = m.recipients[1]
    test.assert_eq(p.kind, 3)
    test.assert_eq_str(p.alg, OID_PWRI_KEK)
    test.assert_eq_str(p.kdf, OID_PBKDF2)
    test.assert_eq_str(text_of(cmsenv.decrypt_with_password(m, bytes.from_str("correct horse"), 100000, None)), "Hello, CMS world.\r\n")
    test.case("a wrong password is the integrity check of the key wrap")
    test.assert_eq_str(said(cmsenv.decrypt_with_password(m, bytes.from_str("wrong horse"), 100000, None)),
        "cms: the signature, digest or tag did not verify")
    test.case("the iteration count is the sender's and the caller bounds it")
    test.assert_eq_str(said(cmsenv.decrypt_with_password(m, bytes.from_str("correct horse"), 2047, None)),
        "cms: unusable key: the iteration count is 2048, the limit is 2047")
    test.assert_eq_str(said(cmsenv.decrypt_with_kek(m, bytes.from_str("KKKK"), kek(), None)),
        "cms: not implemented: KeyTransRecipientInfo: rsa-nv has no RSA decryption, and no KEKRecipientInfo with the key identifier matched")

@test
fn test_password_and_kek_messages_written_here() [io]
    let cek = counter(16, 1)
    let iv = counter(16, 9)
    let kt = CmsKekTarget { key_id: h("4b4b"), kek: kek() }
    let pt = CmsPasswordTarget { password: bytes.from_str("pw"), salt: counter(8, 5), iterations: 1000,
                                 prf: OID_HMAC_SHA256, wrap_alg: OID_AES128_CBC, iv: counter(16, 77), padding: counter(32, 3) }
    let plain = bytes.from_str("written by cms-nv")
    for alg in [OID_AES128_CBC, OID_AES192_CBC, OID_AES256_CBC]
        let klen = cmsinfo.enc_key_len(alg)
        let key = counter(klen, 2)
        match cmsenv.enveloped_write(alg, key, iv, plain, [kt], [pt], false)
            Err(e) => test.fail(e.message())
            Ok(b)  =>
                match cmsenv.enveloped_read(b)
                    Err(e) => test.fail(e.message())
                    Ok(m)  =>
                        test.assert_eq(m.version, 3)
                        test.assert_eq(list.len(m.recipients), 2)
                        test.assert_eq_str(text_of(cmsenv.decrypt_with_kek(m, h("4b4b"), kek(), None)), "written by cms-nv")
                        test.assert_eq_str(text_of(cmsenv.decrypt_with_password(m, bytes.from_str("pw"), 1000, None)), "written by cms-nv")
    test.case("a KEK recipient alone is version 2; every wrap length")
    for len in [16, 24, 32]
        let key = counter(len, 4)
        let k2 = CmsKekTarget { key_id: h("01"), kek: key }
        match cmsenv.enveloped_write(OID_AES128_CBC, cek, iv, plain, [k2], [], false)
            Err(e) => test.fail(e.message())
            Ok(b)  =>
                let m = env_of(hex(b))
                test.assert_eq(m.version, 2)
                test.assert_eq_str(text_of(cmsenv.decrypt_with_kek(m, h("01"), key, None)), "written by cms-nv")
    test.case("SHA-1 and SHA-512 as the PBKDF2 PRF")
    for prf in [OID_HMAC_SHA1, OID_HMAC_SHA512]
        let p2 = CmsPasswordTarget { password: bytes.from_str("pw"), salt: counter(8, 5), iterations: 1000,
                                     prf: prf, wrap_alg: OID_AES256_CBC, iv: counter(16, 77), padding: counter(32, 3) }
        match cmsenv.enveloped_write(OID_AES128_CBC, cek, iv, plain, [], [p2], false)
            Err(e) => test.fail(e.message())
            Ok(b)  => test.assert_eq_str(text_of(cmsenv.decrypt_with_password(env_of(hex(b)), bytes.from_str("pw"), 1000, None)), "written by cms-nv")
    test.case("the writer's refusals")
    test.assert_eq_str(said(cmsenv.enveloped_write(OID_AES128_CBC, cek, iv, plain, [], [], false)), "cms: malformed structure: a message has at least one recipient")
    test.assert_eq_str(said(cmsenv.enveloped_write(OID_AES128_CBC, cek, iv, plain, [CmsKekTarget { key_id: h("01"), kek: h("00") }], [], false)),
        "cms: unusable key: a KEK is 16, 24 or 32 bytes")
    let bad_wrap = CmsPasswordTarget { password: bytes.from_str("pw"), salt: counter(8, 5), iterations: 1000, prf: OID_HMAC_SHA256,
                                       wrap_alg: OID_AES128_GCM, iv: counter(16, 77), padding: counter(32, 3) }
    test.assert_eq_str(said(cmsenv.enveloped_write(OID_AES128_CBC, cek, iv, plain, [], [bad_wrap], false)),
        "cms: algorithm 2.16.840.1.101.3.4.1.6 is not implemented")
    let bad_prf = CmsPasswordTarget { password: bytes.from_str("pw"), salt: counter(8, 5), iterations: 1000, prf: "1.2.3",
                                      wrap_alg: OID_AES128_CBC, iv: counter(16, 77), padding: counter(32, 3) }
    test.assert_eq_str(said(cmsenv.enveloped_write(OID_AES128_CBC, cek, iv, plain, [], [bad_prf], false)), "cms: algorithm 1.2.3 is not implemented")
    let zero_iter = CmsPasswordTarget { password: bytes.from_str("pw"), salt: counter(8, 5), iterations: 0, prf: OID_HMAC_SHA256,
                                        wrap_alg: OID_AES128_CBC, iv: counter(16, 77), padding: counter(32, 3) }
    test.assert_eq_str(said(cmsenv.enveloped_write(OID_AES128_CBC, cek, iv, plain, [], [zero_iter], false)), "cms: unusable key: pbkdf2: 0 is not a positive count")
    let no_salt = CmsPasswordTarget { password: bytes.from_str("pw"), salt: bytes.zeros(0), iterations: 1000, prf: OID_HMAC_SHA256,
                                      wrap_alg: OID_AES128_CBC, iv: counter(16, 77), padding: counter(32, 3) }
    test.assert_eq_str(said(cmsenv.enveloped_write(OID_AES128_CBC, cek, iv, plain, [], [no_salt], false)), "cms: unusable key: the salt is at least 8 bytes")

@test
fn test_openssl_auth_enveloped_data() [io]
    let a = auth_of(authenv())
    test.assert_eq(a.version, 0)
    test.assert_eq_str(a.eci.enc_alg, OID_AES128_GCM)
    test.assert_eq(a.eci.icv_len, 16)
    test.assert_eq(bytes.len(a.eci.iv), 12)
    test.assert_eq(bytes.len(a.mac), 16)
    test.assert_eq_str(text_of(cmsenv.auth_decrypt_with_kek(a, bytes.from_str("KK"), kek(), None)), "Hello, CMS world.\r\n")
    test.case("a changed tag or ciphertext is refused before any plaintext")
    let bad_tag = CmsAuthEnveloped { version: 0, recipients: a.recipients, eci: a.eci, mac: h("00000000000000000000000000000000") }
    test.assert_eq_str(said(cmsenv.auth_decrypt_with_kek(bad_tag, bytes.from_str("KK"), kek(), None)), "cms: the signature, digest or tag did not verify")
    test.assert_eq_str(said(cmsenv.auth_decrypt_with_cek(bad_tag, counter(16, 1), None)), "cms: the signature, digest or tag did not verify")
    test.assert_eq_str(said(cmsenv.auth_decrypt_with_cek(a, counter(15, 1), None)), "cms: unusable key: the content key of 2.16.840.1.101.3.4.1.6 is 16 bytes")
    let short_mac = CmsAuthEnveloped { version: 0, recipients: a.recipients, eci: a.eci, mac: h("0011") }
    test.assert_eq_str(said(cmsenv.auth_decrypt_with_cek(short_mac, counter(16, 1), None)),
        "cms: malformed structure: the MAC is 2 bytes and the parameters say 16")
    test.assert_eq_str(said(cmsenv.auth_decrypt_with_kek(a, bytes.from_str("KK"), kek(), Some(h("00")))), "cms: content was supplied for a message that carries its own")
    test.assert_eq_str(said(cmsenv.auth_decrypt_with_password(a, bytes.from_str("pw"), 100, None)),
        "cms: not implemented: KeyTransRecipientInfo: rsa-nv has no RSA decryption, and no PasswordRecipientInfo matched")
    test.case("an EnvelopedData reader refuses the AuthEnvelopedData and the other way round")
    test.assert_eq_str(said(cmsenv.enveloped_read(h(authenv()))),
        "cms: content type 1.2.840.113549.1.9.16.1.23 where 1.2.840.113549.1.7.3 was expected")
    test.assert_eq_str(said(cmsenv.auth_read(h(kek128()))),
        "cms: content type 1.2.840.113549.1.7.3 where 1.2.840.113549.1.9.16.1.23 was expected")

@test
fn test_auth_enveloped_data_written_here() [io]
    let kt = CmsKekTarget { key_id: h("4b"), kek: kek() }
    let pt = CmsPasswordTarget { password: bytes.from_str("pw"), salt: counter(8, 5), iterations: 1000,
                                 prf: OID_HMAC_SHA256, wrap_alg: OID_AES128_CBC, iv: counter(16, 77), padding: counter(32, 3) }
    for alg in [OID_AES128_GCM, OID_AES192_GCM, OID_AES256_GCM]
        let key = counter(cmsinfo.enc_key_len(alg), 7)
        match cmsenv.auth_write(alg, key, counter(12, 1), bytes.from_str("sealed"), [kt], [pt], false)
            Err(e) => test.fail(e.message())
            Ok(b)  =>
                let a = auth_of(hex(b))
                test.assert_eq_str(text_of(cmsenv.auth_decrypt_with_kek(a, h("4b"), kek(), None)), "sealed")
                test.assert_eq_str(text_of(cmsenv.auth_decrypt_with_password(a, bytes.from_str("pw"), 1000, None)), "sealed")
                test.assert_eq_str(text_of(cmsenv.auth_decrypt_with_cek(a, key, None)), "sealed")
    test.case("detached ciphertext")
    let key = counter(16, 7)
    match cmsenv.auth_write(OID_AES128_GCM, key, counter(12, 1), bytes.from_str("sealed"), [kt], [], true)
        Err(e) => test.fail(e.message())
        Ok(b)  =>
            let a = auth_of(hex(b))
            test.assert_eq(a.eci.encrypted == None, true)
            test.assert_eq_str(said(cmsenv.auth_decrypt_with_cek(a, key, None)), "cms: the message has detached content and none was supplied")
            match cmsenv.auth_write(OID_AES128_GCM, key, counter(12, 1), bytes.from_str("sealed"), [kt], [], false)
                Err(e) => test.fail(e.message())
                Ok(full) =>
                    match cmsenv.auth_read(full)
                        Err(e) => test.fail(e.message())
                        Ok(fa) =>
                            match fa.eci.encrypted
                                None     => test.fail("no ciphertext")
                                Some(ct) => test.assert_eq_str(text_of(cmsenv.auth_decrypt_with_cek(a, key, Some(ct))), "sealed")
    test.assert_eq_str(said(cmsenv.auth_write(OID_AES128_CBC, key, counter(12, 1), bytes.from_str("x"), [kt], [], false)), "cms: algorithm 2.16.840.1.101.3.4.1.2 is not implemented")
    test.assert_eq_str(said(cmsenv.auth_write(OID_AES128_GCM, counter(5, 1), counter(12, 1), bytes.from_str("x"), [kt], [], false)),
        "cms: unusable key: the content key of 2.16.840.1.101.3.4.1.6 is 16 bytes")
    test.assert_eq_str(said(cmsenv.auth_write(OID_AES128_GCM, key, counter(12, 1), bytes.from_str("x"), [], [], false)), "cms: malformed structure: a message has at least one recipient")
    test.assert_eq_str(said(cmsenv.auth_write(OID_AES128_GCM, key, bytes.zeros(0), bytes.from_str("x"), [kt], [], false)), "cms: unusable key: the nonce is not empty")
