// cms_content_tests.nv — ContentInfo, data, digested-data and
// encrypted-data, and the symmetric primitives under them.
//
// RFC 4134 prints its examples as ASN.1 dumps with the octet strings in
// hexadecimal, not as bytes.  Sections 3.1, 3.2, 6 and 7.1 are small enough
// to be written out byte for byte from the dump, with the lengths the dump
// states, and are checked against it here.  The OpenSSL vectors below were
// made once with OpenSSL 3.0.13 (tests/generate/gen_cms_vectors.sh has the
// commands) and are checked in as hex.

use std.test
use std.bytes
use std.list
use cmserr
use cmsoid
use cmsder
use cmscrypto
use cmsinfo

fn said<T>(r: Result<T, CmsError>) -> Str
    match r
        Ok(_)  => "ok"
        Err(e) => e.message()

fn h(s: Str) -> Bytes
    bytes.from_hex(s) ?? bytes.zeros(0)

fn hex(b: Bytes) -> Str
    bytes.to_hex(b)

fn text_of(r: Result<Bytes, CmsError>) -> Str
    match r
        Ok(b)  => bytes.to_str(b)
        Err(e) => e.message()

fn sample() -> Bytes
    bytes.from_str("This is some sample content.")

// RFC 4134 section 3.1: a Data ContentInfo in BER, indefinite lengths and a
// constructed OCTET STRING of two chunks.
fn rfc4134_3_1() -> Str
    "3080" + "06092a864886f70d010701" + "a080" + "2480" + "040454686973" + "041820697320736f6d652073616d706c6520636f6e74656e742e" + "0000" + "0000" + "0000"

// RFC 4134 section 3.2: the same in DER, 43 octets.
fn rfc4134_3_2() -> Str
    "302b" + "06092a864886f70d010701" + "a01e" + "041c" + hex(sample())

// RFC 4134 section 6: a DigestedData of the sample with SHA-1, 94 octets.
fn rfc4134_6() -> Str
    "305e" + "06092a864886f70d010705" + "a051" + "304f" + "020100" + "300706052b0e03021a" + "302b06092a864886f70d010701a01e041c" + hex(sample()) + "0414406aec085279ba6e16022d9e0629c0229687dd48"

// RFC 4134 section 7.1: an EncryptedData with DES-EDE3-CBC, 89 octets.
fn rfc4134_7_1() -> Str
    "3057" + "06092a864886f70d010706" + "a04a" + "3048" + "020100" + "3043" + "06092a864886f70d010701" + "3014" + "06082a864886f70d0307" + "0408b36b6bfb6231084e" + "8020" + "fafceddb3f18171d3889" + "11ea34d620dbf4c3d95815ef933b9af5d704f6b570e2"

fn secret256() -> Bytes
    h("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")

fn rsa_pkcs1() -> Str
    ""

fn rsa_pss() -> Str
    ""

fn ec() -> Str
    ""

fn ec_detached() -> Str
    ""

fn certs_only() -> Str
    ""

fn kek128() -> Str
    ""

fn pwri() -> Str
    ""

fn authenv() -> Str
    ""

fn encdata() -> Str
    "306006092a864886f70d010706a0533051020100304c06092a864886f70d010701301d060960864801650304012a041088a5713cdbdb2b15afa25b35a2101aaf8020f8ae00f2c2e07aec983ebb7da869756ae7072ca56d0577bfca1ddf6f12b5cac0"

fn digested() -> Str
    "306506092a864886f70d010705a0583056020100300b0609608648016503040201302206092a864886f70d010701a015041348656c6c6f2c20434d5320776f726c642e0d0a04206761903d7fd37a026b6c62847957cfb5a72d75dbeab1f05f2839e941bd400e3b"

fn cert_rsa() -> Str
    ""

fn cert_ec() -> Str
    ""

@test
fn test_rfc4134_3_data_in_ber_and_der() [io]
    test.assert_eq_str(text_of(cmsinfo.data_read(h(rfc4134_3_1()))), "This is some sample content.")
    test.assert_eq_str(text_of(cmsinfo.data_read(h(rfc4134_3_2()))), "This is some sample content.")
    test.case("writing the sample gives the DER of 3.2, 43 octets")
    match cmsinfo.data_write(sample())
        Ok(b)  =>
            test.assert_eq_str(hex(b), rfc4134_3_2())
            test.assert_eq(bytes.len(b), 45)
        Err(e) => test.fail(e.message())
    test.case("a ContentInfo is read whole: the type and the content")
    match cmsinfo.read(h(rfc4134_3_1()))
        Err(e) => test.fail(e.message())
        Ok(info) =>
            test.assert_eq_str(info.content_type, OID_DATA)
            test.assert_eq(info.content == None, false)

@test
fn test_rfc4134_6_digested_data() [io]
    match cmsinfo.digested_read(h(rfc4134_6()))
        Err(e) => test.fail(e.message())
        Ok(d)  =>
            test.assert_eq_str(d.digest_alg, OID_SHA1)
            test.assert_eq_str(d.content_type, OID_DATA)
            test.assert_eq_str(hex(d.digest), "406aec085279ba6e16022d9e0629c0229687dd48")
            test.assert_eq_str(text_of(cmsinfo.digested_verify(d, None)), "This is some sample content.")
            test.case("content supplied as well as carried")
            test.assert_eq_str(said(cmsinfo.digested_verify(d, Some(sample()))),
                "cms: content was supplied for a message that carries its own")
            test.case("a changed digest")
            let bad = CmsDigested { digest_alg: d.digest_alg, content_type: d.content_type, content: d.content,
                                    digest: h("406aec085279ba6e16022d9e0629c0229687dd49") }
            test.assert_eq_str(said(cmsinfo.digested_verify(bad, None)), "cms: the signature, digest or tag did not verify")
    test.case("writing the sample with SHA-1 gives the RFC's 96 octets")
    match cmsinfo.digested_write(OID_SHA1, sample(), false)
        Ok(b)  => test.assert_eq_str(hex(b), rfc4134_6())
        Err(e) => test.fail(e.message())

@test
fn test_digested_data_detached_and_openssl() [io]
    match cmsinfo.digested_write(OID_SHA256, bytes.from_str("detach me"), true)
        Err(e) => test.fail(e.message())
        Ok(b)  =>
            match cmsinfo.digested_read(b)
                Err(e) => test.fail(e.message())
                Ok(d)  =>
                    test.assert_eq(d.content == None, true)
                    test.assert_eq_str(said(cmsinfo.digested_verify(d, None)), "cms: the message has detached content and none was supplied")
                    test.assert_eq_str(text_of(cmsinfo.digested_verify(d, Some(bytes.from_str("detach me")))), "detach me")
                    test.assert_eq_str(said(cmsinfo.digested_verify(d, Some(bytes.from_str("detach you")))),
                        "cms: the signature, digest or tag did not verify")
    test.case("OpenSSL: cms -digest_create -md sha256")
    match cmsinfo.digested_read(h(digested()))
        Err(e) => test.fail(e.message())
        Ok(d)  =>
            test.assert_eq_str(d.digest_alg, OID_SHA256)
            test.assert_eq_str(text_of(cmsinfo.digested_verify(d, None)), "Hello, CMS world.\r\n")
    match cmsinfo.digested_write(OID_SHA256, bytes.from_str("Hello, CMS world.\r\n"), false)
        Ok(b)  => test.assert_eq_str(hex(b), digested())
        Err(e) => test.fail(e.message())
    test.assert_eq_str(said(cmsinfo.digested_write("1.2.3", sample(), false)), "cms: algorithm 1.2.3 is not implemented")

@test
fn test_encrypted_data() [io]
    test.case("RFC 4134 7.1 is TripleDES, which the registry cannot run: the structure is refused by name")
    test.assert_eq_str(said(cmsinfo.encrypted_read(h(rfc4134_7_1()))),
        "cms: not implemented: DES-EDE3-CBC content encryption: the registry has no 3DES")
    test.case("OpenSSL: cms -EncryptedData_encrypt -aes-256-cbc")
    match cmsinfo.encrypted_read(h(encdata()))
        Err(e) => test.fail(e.message())
        Ok(e)  =>
            test.assert_eq(e.version, 0)
            test.assert_eq_str(e.eci.enc_alg, OID_AES256_CBC)
            test.assert_eq(bytes.len(e.eci.iv), 16)
            test.assert_eq_str(text_of(cmsinfo.encrypted_decrypt(e, secret256(), None)), "Hello, CMS world.\r\n")
            test.assert_eq_str(said(cmsinfo.encrypted_decrypt(e, h("00"), None)),
                "cms: unusable key: the content key of 2.16.840.1.101.3.4.1.42 is 32 bytes")
            test.assert_eq_str(said(cmsinfo.encrypted_decrypt(e, secret256(), Some(sample()))),
                "cms: content was supplied for a message that carries its own")
            test.case("writing it again with the same key and IV gives OpenSSL's bytes")
            match cmsinfo.encrypted_write(OID_AES256_CBC, secret256(), e.eci.iv, bytes.from_str("Hello, CMS world.\r\n"), false)
                Ok(b)  => test.assert_eq_str(hex(b), encdata())
                Err(m) => test.fail(m.message())
            test.case("a wrong key gives bad padding or garbage, and padding is the only check CBC has")
            test.assert_eq_str(said(cmsinfo.encrypted_decrypt(e, h("ff0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"), None)),
                "cms: the signature, digest or tag did not verify")
    test.case("detached ciphertext")
    match cmsinfo.encrypted_write(OID_AES128_CBC, h("000102030405060708090a0b0c0d0e0f"), h("0f0e0d0c0b0a09080706050403020100"), sample(), true)
        Err(e) => test.fail(e.message())
        Ok(b)  =>
            match cmsinfo.encrypted_read(b)
                Err(e) => test.fail(e.message())
                Ok(e)  =>
                    test.assert_eq(e.eci.encrypted == None, true)
                    test.assert_eq_str(said(cmsinfo.encrypted_decrypt(e, h("000102030405060708090a0b0c0d0e0f"), None)),
                        "cms: the message has detached content and none was supplied")
    test.assert_eq_str(said(cmsinfo.encrypted_write("1.2.3", h("00"), h("00"), sample(), false)), "cms: algorithm 1.2.3 is not implemented")
    test.assert_eq_str(said(cmsinfo.encrypted_write(OID_AES128_GCM, h("00"), h("00"), sample(), false)), "cms: algorithm 2.16.840.1.101.3.4.1.6 is not implemented")
    test.assert_eq_str(said(cmsinfo.encrypted_write(OID_AES128_CBC, h("00"), h("00"), sample(), false)),
        "cms: unusable key: the content key of 2.16.840.1.101.3.4.1.2 is 16 bytes")

@test
fn test_content_info_refusals() [io]
    test.assert_eq_str(said(cmsinfo.data_read(h(digested()))), "cms: content type 1.2.840.113549.1.7.5 where 1.2.840.113549.1.7.1 was expected")
    test.assert_eq_str(said(cmsinfo.data_read(h("0500"))), "cms: malformed structure: a ContentInfo is not the expected type")
    test.assert_eq_str(said(cmsinfo.data_read(h("3000"))), "cms: malformed structure: the content type is missing")
    test.assert_eq_str(said(cmsinfo.data_read(h("30030401aa"))), "cms: malformed structure: an OBJECT IDENTIFIER")
    test.assert_eq_str(said(cmsinfo.data_read(h("300b06092a864886f70d010701"))), "cms: the message has detached content and none was supplied")
    test.assert_eq_str(said(cmsinfo.data_read(h("300d06092a864886f70d010701" + "0500"))), "cms: malformed structure: the content is under [0]")
    test.assert_eq_str(said(cmsinfo.data_read(h("300d06092a864886f70d010701" + "a000"))), "cms: malformed structure: the content is missing")
    test.assert_eq_str(said(cmsinfo.data_read(h("300f06092a864886f70d010701" + "a0020500"))), "cms: malformed structure: the data is not the expected type")
    test.assert_eq_str(said(cmsinfo.data_read(h(rfc4134_3_2() + "00"))), "cms: malformed structure: bytes follow the value")
    test.assert_eq_str(said(cmsinfo.data_read(h("30"))), "cms: malformed structure: asn1: the input ends at byte 1 with 1 more byte(s) needed")
    test.assert_eq_str(said(cmsinfo.digested_read(h(rfc4134_3_2()))), "cms: content type 1.2.840.113549.1.7.1 where 1.2.840.113549.1.7.5 was expected")

@test
fn test_digests_and_cbc_primitives() [io]
    test.assert_eq(cmscrypto.digest_len(OID_SHA1), 20)
    test.assert_eq(cmscrypto.digest_len(OID_SHA256), 32)
    test.assert_eq(cmscrypto.digest_len(OID_SHA384), 48)
    test.assert_eq(cmscrypto.digest_len(OID_SHA512), 64)
    test.assert_eq(cmscrypto.digest_len("1.2.3"), 0)
    match cmscrypto.digest_of(OID_SHA384, bytes.from_str("abc"))
        Ok(d)  => test.assert_eq(bytes.len(d), 48)
        Err(e) => test.fail(e.message())
    match cmscrypto.digest_of(OID_SHA512, bytes.from_str("abc"))
        Ok(d)  => test.assert_eq(bytes.len(d), 64)
        Err(e) => test.fail(e.message())
    test.assert_eq_str(said(cmscrypto.digest_of("1.2.3", h(""))), "cms: algorithm 1.2.3 is not implemented")
    test.case("padding of every length, and the refusals")
    for n in 0..34
        match cmscrypto.cbc_encrypt(h("2b7e151628aed2a6abf7158809cf4f3c"), h("000102030405060708090a0b0c0d0e0f"), bytes.zeros(n))
            Err(e) => test.fail(e.message())
            Ok(ct) =>
                test.assert_eq(bytes.len(ct), (n / 16 + 1) * 16)
                match cmscrypto.cbc_decrypt(h("2b7e151628aed2a6abf7158809cf4f3c"), h("000102030405060708090a0b0c0d0e0f"), ct)
                    Ok(p)  => test.assert_eq(bytes.len(p), n)
                    Err(e) => test.fail(e.message())
    test.assert_eq(cmscrypto.unpad(bytes.zeros(0)) == None, true)
    test.assert_eq(cmscrypto.unpad(bytes.zeros(16)) == None, true)
    test.assert_eq(cmscrypto.unpad(bytes.fill(bytes.zeros(16), 0, 16, 17)) == None, true)
    test.assert_eq(cmscrypto.unpad(h("00000000000000000000000000000203")) == None, true)
    test.assert_eq_str(said(cmscrypto.cbc_decrypt(h("2b7e151628aed2a6abf7158809cf4f3c"), h("00"), bytes.zeros(16))),
        "cms: unusable key: CBC takes a 16-byte IV and whole blocks")
    test.assert_eq_str(said(cmscrypto.cbc_encrypt(h("2b7e151628aed2a6abf7158809cf4f3c"), h("00"), bytes.zeros(16))),
        "cms: unusable key: CBC takes a 16-byte IV and whole blocks")
    test.assert_eq_str(said(cmscrypto.cbc_decrypt(h("00"), h("000102030405060708090a0b0c0d0e0f"), bytes.zeros(16))),
        "cms: unusable key: an AES key is 16, 24 or 32 bytes")
    test.assert_eq_str(said(cmscrypto.cbc_decrypt(h("2b7e151628aed2a6abf7158809cf4f3c"), h("000102030405060708090a0b0c0d0e0f"), bytes.zeros(0))),
        "cms: the signature, digest or tag did not verify")

@test
fn test_rfc3394_key_wrap_vectors() [io]
    let k128 = h("000102030405060708090a0b0c0d0e0f")
    let k256 = h("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    let d128 = h("00112233445566778899aabbccddeeff")
    let d256 = h("00112233445566778899aabbccddeeff000102030405060708090a0b0c0d0e0f")
    match cmscrypto.kw_wrap(k128, d128)
        Ok(w)  =>
            test.assert_eq_str(hex(w), "1fa68b0a8112b447aef34bd8fb5a7b829d3e862371d2cfe5")
        Err(e) => test.fail(e.message())
    match cmscrypto.kw_unwrap(k128, h("1fa68b0a8112b447aef34bd8fb5a7b829d3e862371d2cfe5"))
        Ok(p)  => test.assert_eq_str(hex(p), hex(d128))
        Err(e) => test.fail(e.message())
    match cmscrypto.kw_wrap(k256, d256)
        Ok(w)  => test.assert_eq_str(hex(w), "28c9f404c4b810f4cbccb35cfb87f8263f5786e2d80ed326cbc7f0e71a99f43bfb988b9b7a02dd21")
        Err(e) => test.fail(e.message())
    match cmscrypto.kw_unwrap(k256, h("28c9f404c4b810f4cbccb35cfb87f8263f5786e2d80ed326cbc7f0e71a99f43bfb988b9b7a02dd21"))
        Ok(p)  => test.assert_eq_str(hex(p), hex(d256))
        Err(e) => test.fail(e.message())
    test.assert_eq_str(said(cmscrypto.kw_wrap(k128, h("0011223344556677"))), "cms: unusable key: the key to wrap is a multiple of 8 bytes and at least 16")
    test.assert_eq_str(said(cmscrypto.kw_wrap(h("00"), d128)), "cms: unusable key: an AES key is 16, 24 or 32 bytes")
    test.assert_eq_str(said(cmscrypto.kw_unwrap(h("00"), h("1fa68b0a8112b447aef34bd8fb5a7b829d3e862371d2cfe5"))), "cms: unusable key: an AES key is 16, 24 or 32 bytes")
    test.assert_eq_str(said(cmscrypto.kw_unwrap(k128, h("1fa68b0a8112b447"))), "cms: the signature, digest or tag did not verify")
    test.assert_eq_str(said(cmscrypto.kw_unwrap(k128, h("1fa68b0a8112b447aef34bd8fb5a7b829d3e862371d2cfe4"))), "cms: the signature, digest or tag did not verify")

@test
fn test_rfc3211_key_wrap_round_trips() [io]
    let kek = h("000102030405060708090a0b0c0d0e0f")
    let iv = h("0f0e0d0c0b0a09080706050403020100")
    test.assert_eq(cmscrypto.pwri_pad_len(16), 12)
    test.assert_eq(cmscrypto.pwri_pad_len(28), 0)
    test.assert_eq(cmscrypto.pwri_pad_len(29), 15)
    test.assert_eq(cmscrypto.pwri_pad_len(32), 12)
    for n in [4, 16, 24, 28, 29, 32, 64]
        var cek = bytes.zeros(n)
        for i in 0..n
            bytes.set_u8(cek, i, i * 5 + 1)
        match cmscrypto.pwri_wrap(kek, iv, cek, bytes.zeros(32))
            Err(e) => test.fail(e.message())
            Ok(w)  =>
                test.assert_eq(bytes.len(w) % 16, 0)
                test.assert_eq(bytes.len(w) >= 32, true)
                match cmscrypto.pwri_unwrap(kek, iv, w)
                    Ok(p)  => test.assert_eq_str(hex(p), hex(cek))
                    Err(e) => test.fail(e.message())
                test.assert_eq_str(said(cmscrypto.pwri_unwrap(h("0f0e0d0c0b0a09080706050403020100"), iv, w)), "cms: the signature, digest or tag did not verify")
    test.assert_eq_str(said(cmscrypto.pwri_wrap(kek, iv, h("00"), bytes.zeros(16))), "cms: unusable key: the key to wrap is 4 to 255 bytes")
    test.assert_eq_str(said(cmscrypto.pwri_wrap(kek, iv, bytes.zeros(16), h("00"))), "cms: unusable key: the padding is 12 bytes")
    test.assert_eq_str(said(cmscrypto.pwri_unwrap(kek, iv, bytes.zeros(16))), "cms: the signature, digest or tag did not verify")
    test.assert_eq_str(said(cmscrypto.pwri_unwrap(kek, iv, bytes.zeros(33))), "cms: the signature, digest or tag did not verify")
    test.assert_eq_str(said(cmscrypto.pwri_unwrap(kek, iv, bytes.zeros(32))), "cms: the signature, digest or tag did not verify")

@test
fn test_gcm_seal_and_open() [io]
    let key = h("000102030405060708090a0b0c0d0e0f")
    let nonce = h("000102030405060708090a0b")
    match cmscrypto.gcm_seal(key, nonce, h("aa"), sample())
        Err(e) => test.fail(e.message())
        Ok(s)  =>
            test.assert_eq(bytes.len(s.tag), 16)
            test.assert_eq_str(text_of(cmscrypto.gcm_open(key, nonce, h("aa"), s.ciphertext, s.tag)), "This is some sample content.")
            test.assert_eq_str(said(cmscrypto.gcm_open(key, nonce, h("ab"), s.ciphertext, s.tag)), "cms: the signature, digest or tag did not verify")
            test.assert_eq_str(said(cmscrypto.gcm_open(key, nonce, h("aa"), s.ciphertext, h("00"))),
                "cms: not implemented: an AES-GCM tag of 1 bytes, only 16 is implemented")
    test.assert_eq_str(said(cmscrypto.gcm_seal(key, h(""), h(""), h(""))), "cms: unusable key: the nonce is not empty")
    test.assert_eq_str(said(cmscrypto.gcm_seal(h("00"), nonce, h(""), h(""))), "cms: unusable key: an AES key is 16, 24 or 32 bytes")
