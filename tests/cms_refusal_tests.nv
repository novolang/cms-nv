// cms_refusal_tests.nv — what the readers and the verifier refuse.
//
// Every message here is built from DER pieces written out in the test, or
// is a vector of the other suites with a few bytes changed.  The pieces are
// small on purpose: each one reaches one refusal and says in its name which.

use std.test
use std.bytes
use std.list
use cmserr
use cmsoid
use cmsder
use cmscrypto
use cmsinfo
use cmsenv
use cmssigned

fn said<T>(r: Result<T, CmsError>) -> Str
    match r
        Ok(_)  => "ok"
        Err(e) => e.message()

fn h(s: Str) -> Bytes
    bytes.from_hex(s) ?? bytes.zeros(0)

fn hex(b: Bytes) -> Str
    bytes.to_hex(b)

fn must(r: Result<Bytes, CmsError>) -> Bytes
    match r
        Ok(b)  => bytes.clone(b)
        Err(e) =>
            test.fail(e.message())
            bytes.zeros(0)

fn t(tag: Int, body: Str) -> Str
    hex(cmsder.tlv(tag, h(body)))

fn oidh(text: Str) -> Str
    hex(must(cmsder.oid(text)))

fn algh(text: Str) -> Str
    t(48, oidh(text))

fn algp(text: Str, params: Str) -> Str
    t(48, oidh(text) + params)

fn inth(n: Int) -> Str
    hex(cmsder.int_u(n))

fn octh(body: Str) -> Str
    t(4, body)

fn zeros(n: Int) -> Str
    hex(bytes.zeros(n))

// A ContentInfo of this type around a SEQUENCE of the members given.
fn wrapped(type_oid: Str, inner: Str) -> Str
    hex(must(cmsinfo.write(type_oid, h(t(48, inner)))))

// An EncryptedContentInfo with AES-128-CBC and 32 bytes of ciphertext.
fn eci_cbc() -> Str
    t(48, oidh(OID_DATA) + algp(OID_AES128_CBC, octh(zeros(16))) + t(128, zeros(32)))

fn enveloped(pre: Str, recipients: Str) -> Str
    wrapped(OID_ENVELOPED_DATA, inth(2) + pre + t(49, recipients) + eci_cbc())

fn kekri(id: Str, alg: Str, ek: Str) -> Str
    t(162, inth(4) + t(48, octh(id)) + alg + octh(ek))

fn ktri_ski(ski: Str) -> Str
    t(48, inth(2) + t(128, ski) + algh(OID_RSA_ENCRYPTION) + octh(zeros(8)))

fn read_env(hexed: Str) -> Str
    said(cmsenv.enveloped_read(h(hexed)))

fn auth_msg(eci: Str, rest: Str, recipients: Str) -> Str
    wrapped(OID_AUTH_ENVELOPED_DATA, inth(0) + t(49, recipients) + eci + rest)

fn counter(n: Int, seed: Int) -> Bytes
    var b = bytes.zeros(n)
    for i in 0..n
        bytes.set_u8(b, i, i * 3 + seed)
    b

fn some_message(recipients: Str) -> CmsEnveloped
    match cmsenv.enveloped_read(h(enveloped("", recipients)))
        Ok(m)  => m
        Err(e) =>
            test.fail(e.message())
            CmsEnveloped { version: 0, recipients: [], eci: CmsEci { content_type: "", enc_alg: "", iv: bytes.zeros(0), icv_len: 0, encrypted: None } }

fn rsa_pkcs1() -> Str
    ""

fn rsa_pss() -> Str
    ""

fn ec() -> Str
    ""

fn ec_detached() -> Str
    ""

fn certs_only() -> Str
    ""

fn kek128() -> Str
    ""

fn pwri() -> Str
    ""

fn authenv() -> Str
    ""

fn encdata() -> Str
    "306006092a864886f70d010706a0533051020100304c06092a864886f70d010701301d060960864801650304012a041088a5713cdbdb2b15afa25b35a2101aaf8020f8ae00f2c2e07aec983ebb7da869756ae7072ca56d0577bfca1ddf6f12b5cac0"

fn digested() -> Str
    "306506092a864886f70d010705a0583056020100300b0609608648016503040201302206092a864886f70d010701a015041348656c6c6f2c20434d5320776f726c642e0d0a04206761903d7fd37a026b6c62847957cfb5a72d75dbeab1f05f2839e941bd400e3b"

fn cert_rsa() -> Str
    ""

fn cert_ec() -> Str
    ""
fn cert_ed() -> Str
    ""
fn ec_scalar() -> Str
    "32383af9d7c4b0f918a2c374bbbc277d537a383d959b9135070382d7bfb15230"

fn ed_seed() -> Str
    "1b1089dca503a0dedbfdc5bc743c65fd7e4daedff61dbf06ffdff20daef0b675"
fn cert_plain() -> Str
    ""

fn cert_r1024() -> Str
    ""

fn cert_p384() -> Str
    ""

@test
fn test_der_helpers() [io]
    test.case("classes other than universal and context")
    match cmsder.node_at(h("4001aa"), 0)
        Ok(n)  => test.assert_eq(n.cls, 1)
        Err(e) => test.fail(e.message())
    match cmsder.node_at(h("c001aa"), 0)
        Ok(n)  => test.assert_eq(n.cls, 3)
        Err(e) => test.fail(e.message())
    test.case("a truncated value, and an integer too long for an Int")
    test.assert_eq_str(said(cmsder.node_at(h("3005020101"), 0)), "cms: malformed structure: asn1: a length of 5 at byte 0 runs past the 3 byte(s) left")
    test.assert_eq_str(said(cmsder.node_at(h(""), 0)), "cms: malformed structure: asn1: the input ends at byte 0 with 1 more byte(s) needed")
    match cmsder.node_at(h("0205000000000100"), 0)
        Ok(n)  => test.assert_eq_str(said(cmsder.int_value(n)), "cms: malformed structure: an INTEGER of up to four octets")
        Err(e) => test.fail(e.message())
    match cmsder.node_at(h("0500"), 0)
        Ok(n)  =>
            test.assert_eq_str(said(cmsder.oid_text(n)), "cms: malformed structure: an OBJECT IDENTIFIER")
            test.assert_eq_str(said(cmsder.children(n)), "cms: malformed structure: a primitive value has no members")
        Err(e) => test.fail(e.message())
    match cmsder.node_at(h("06032b0301"), 0)
        Ok(n)  => test.assert_eq_str(said(cmsder.oid_text(n)), "ok")
        Err(e) => test.fail(e.message())
    match cmsder.node_at(h("0602ffff"), 0)
        Ok(n)  => test.assert_eq_str(said(cmsder.oid_text(n)), "cms: malformed structure: asn1: an OBJECT IDENTIFIER that is empty, padded or unfinished at byte 1")
        Err(e) => test.fail(e.message())
    test.case("writing: long lengths, an empty integer, bad object identifiers")
    test.assert_eq(bytes.len(cmsder.tlv(4, bytes.zeros(70000))), 70006)
    test.assert_eq(bytes.len(cmsder.tlv(4, bytes.zeros(300))), 304)
    test.assert_eq_str(hex(cmsder.int_bytes(bytes.zeros(0))), "020100")
    test.assert_eq_str(hex(cmsder.int_bytes(h("0000ff"))), "020200ff")
    test.assert_eq_str(hex(cmsder.int_u(0)), "020100")
    test.assert_eq_str(said(cmsder.oid("1.x.3")), "cms: malformed structure: the object identifier 1.x.3")
    test.assert_eq_str(said(cmsder.oid("1")), "cms: malformed structure: the object identifier 1")
    test.assert_eq_str(hex(must(cmsder.oid("2.100.3"))), "0603813403")
    test.assert_eq_str(hex(cmsder.utc_time(0)), "170d3730303130313030303030305a")
    test.assert_eq_str(hex(cmsder.utc_time(951782400)), "170d3030303232393030303030305a")

@test
fn test_content_info_and_eci_refusals() [io]
    test.assert_eq_str(said(cmsinfo.digested_read(h(wrapped(OID_DIGESTED_DATA, inth(0) + algh(OID_SHA1) + t(48, oidh(OID_DATA) + "0500") + octh(zeros(20)))))),
        "cms: malformed structure: the content is under [0]")
    test.case("EncryptedContentInfo: RC2, an unknown algorithm, no parameters, a content that is not [0]")
    let rc2 = wrapped(OID_ENCRYPTED_DATA, inth(0) + t(48, oidh(OID_DATA) + algh(OID_RC2_CBC)))
    test.assert_eq_str(said(cmsinfo.encrypted_read(h(rc2))), "cms: not implemented: RC2-CBC content encryption: the registry has no RC2")
    let odd = wrapped(OID_ENCRYPTED_DATA, inth(0) + t(48, oidh(OID_DATA) + algh("1.2.3")))
    test.assert_eq_str(said(cmsinfo.encrypted_read(h(odd))), "cms: algorithm 1.2.3 is not implemented")
    let no_params = wrapped(OID_ENCRYPTED_DATA, inth(0) + t(48, oidh(OID_DATA) + algh(OID_AES128_CBC)))
    test.assert_eq_str(said(cmsinfo.encrypted_read(h(no_params))), "cms: malformed structure: the content encryption parameters")
    let bad_tag = wrapped(OID_ENCRYPTED_DATA, inth(0) + t(48, oidh(OID_DATA) + algp(OID_AES128_CBC, octh(zeros(16))) + "0500"))
    test.assert_eq_str(said(cmsinfo.encrypted_read(h(bad_tag))), "cms: malformed structure: the encrypted content is [0]")
    test.case("AES-GCM content is not EnvelopedData content; a detached ciphertext is supplied")
    let gcm_eci = wrapped(OID_ENCRYPTED_DATA, inth(0) + t(48, oidh(OID_DATA) + algp(OID_AES128_GCM, t(48, octh(zeros(12)))) + t(128, zeros(32))))
    match cmsinfo.encrypted_read(h(gcm_eci))
        Err(e) => test.fail(e.message())
        Ok(e)  =>
            test.assert_eq(e.eci.icv_len, 12)
            test.assert_eq_str(said(cmsinfo.encrypted_decrypt(e, zeros_b(16), None)), "cms: malformed structure: AES-GCM content is AuthEnvelopedData, not EnvelopedData")
    let detached = wrapped(OID_ENCRYPTED_DATA, inth(0) + t(48, oidh(OID_DATA) + algp(OID_AES128_CBC, octh(zeros(16)))))
    match cmsinfo.encrypted_read(h(detached))
        Err(e) => test.fail(e.message())
        Ok(e)  => test.assert_eq_str(said(cmsinfo.encrypted_decrypt(e, zeros_b(16), Some(zeros_b(16)))), "cms: the signature, digest or tag did not verify")

fn zeros_b(n: Int) -> Bytes
    bytes.zeros(n)

@test
fn test_recipient_readers() [io]
    let rsa = algh(OID_RSA_ENCRYPTION)
    test.case("a KeyTransRecipientInfo that names its key by subject key identifier")
    let m = some_message(ktri_ski("aabb"))
    test.assert_eq_str(hex(m.recipients[0].key_id), "aabb")
    test.assert_eq(m.recipients[0].kind, 0)
    test.assert_eq_str(read_env(enveloped("", t(48, inth(2) + "0500" + rsa + octh("00")))), "cms: malformed structure: the recipient identifier")
    test.case("the other kinds are read and not opened")
    let kari = some_message(t(161, ""))
    test.assert_eq(kari.recipients[0].kind, 1)
    test.assert_eq_str(said(cmsenv.decrypt_with_kek(kari, h("01"), zeros_b(16), None)),
        "cms: not implemented: KeyAgreeRecipientInfo: the ECDH recipient of RFC 5753 is not implemented, and no KEKRecipientInfo with the key identifier matched")
    let ori = some_message(t(164, ""))
    test.assert_eq(ori.recipients[0].kind, 4)
    test.assert_eq_str(said(cmsenv.decrypt_with_kek(ori, h("01"), zeros_b(16), None)), "cms: no match: KEKRecipientInfo with the key identifier")
    test.assert_eq_str(read_env(enveloped("", "0500")), "cms: malformed structure: a RecipientInfo")
    test.case("the shape of the message")
    test.assert_eq_str(said(cmsenv.enveloped_read(h(wrapped(OID_ENVELOPED_DATA, inth(2) + "3000" + eci_cbc())))), "cms: malformed structure: the recipient infos are a SET")
    test.assert_eq_str(read_env(enveloped("", "")), "cms: malformed structure: a message has at least one recipient")
    test.assert_eq_str(read_env(enveloped("a000", ktri_ski("aa"))), "ok")
    test.assert_eq_str(said(cmsenv.auth_read(h(auth_msg(eci_cbc(), "", ktri_ski("aa"))))), "cms: malformed structure: the MAC is missing")
    test.assert_eq_str(said(cmsenv.auth_read(h(auth_msg(eci_cbc(), "a100" + octh("00"), ktri_ski("aa"))))), "cms: not implemented: authenticated attributes of AuthEnvelopedData")
    let with_origin = wrapped(OID_AUTH_ENVELOPED_DATA, inth(0) + "a000" + t(49, ktri_ski("aa")) + eci_cbc() + octh(zeros(16)))
    test.assert_eq_str(said(cmsenv.auth_read(h(with_origin))), "ok")
    let cbc_auth = some_auth(eci_cbc(), ktri_ski("aa"))
    test.assert_eq_str(said(cmsenv.auth_decrypt_with_cek(cbc_auth, zeros_b(16), None)), "cms: algorithm 2.16.840.1.101.3.4.1.2 is not implemented")

fn some_auth(eci: Str, recipients: Str) -> CmsAuthEnveloped
    match cmsenv.auth_read(h(auth_msg(eci, octh(zeros(16)), recipients)))
        Ok(m)  => m
        Err(e) =>
            test.fail(e.message())
            CmsAuthEnveloped { version: 0, recipients: [], eci: CmsEci { content_type: "", enc_alg: "", iv: bytes.zeros(0), icv_len: 0, encrypted: None }, mac: bytes.zeros(0) }

@test
fn test_kek_and_password_recipient_refusals() [io]
    test.case("a KEK recipient with an algorithm that is not an AES wrap")
    let odd = some_message(kekri("01", algh("1.2.3"), zeros(24)))
    test.assert_eq_str(said(cmsenv.decrypt_with_kek(odd, h("01"), zeros_b(16), None)), "cms: algorithm 1.2.3 is not implemented")
    let pbkdf2 = t(48, octh(zeros(8)) + inth(1000))
    test.case("a password recipient: the KDF, its parameters, the wrap algorithm, its parameters and the cipher inside")
    let wrong_kdf = pwri_hex(algh("1.2.3") , algp(OID_PWRI_KEK, algp(OID_AES128_CBC, octh(zeros(16)))))
    test.assert_eq_str(said(cmsenv.decrypt_with_password(some_message(wrong_kdf), h("70"), 100, None)), "cms: algorithm 1.2.3 is not implemented")
    let no_kdf_params = pwri_hex(algh(OID_PBKDF2), algp(OID_PWRI_KEK, algp(OID_AES128_CBC, octh(zeros(16)))))
    test.assert_eq_str(said(cmsenv.decrypt_with_password(some_message(no_kdf_params), h("70"), 100, None)), "cms: malformed structure: the PBKDF2 parameters")
    let kdf = algp(OID_PBKDF2, pbkdf2)
    let wrong_wrap = pwri_hex(kdf, algp("1.2.3", algp(OID_AES128_CBC, octh(zeros(16)))))
    test.assert_eq_str(said(cmsenv.decrypt_with_password(some_message(wrong_wrap), h("70"), 100000, None)), "cms: algorithm 1.2.3 is not implemented")
    let no_wrap_params = pwri_hex(kdf, algh(OID_PWRI_KEK))
    test.assert_eq_str(said(cmsenv.decrypt_with_password(some_message(no_wrap_params), h("70"), 100000, None)), "cms: malformed structure: the key encryption parameters")
    let odd_cipher = pwri_hex(kdf, algp(OID_PWRI_KEK, algh("1.2.3")))
    test.assert_eq_str(said(cmsenv.decrypt_with_password(some_message(odd_cipher), h("70"), 100000, None)), "cms: algorithm 1.2.3 is not implemented")
    let no_iv = pwri_hex(kdf, algp(OID_PWRI_KEK, algh(OID_AES128_CBC)))
    test.assert_eq_str(said(cmsenv.decrypt_with_password(some_message(no_iv), h("70"), 100000, None)), "cms: malformed structure: the wrapping IV")
    test.case("PBKDF2 parameters with a key length, with SHA-256 and with an unknown PRF")
    let with_len = algp(OID_PBKDF2, t(48, octh(zeros(8)) + inth(1000) + inth(16) + algp(OID_HMAC_SHA256, "0500")))
    let ok_shape = pwri_hex(with_len, algp(OID_PWRI_KEK, algp(OID_AES128_CBC, octh(zeros(16)))))
    test.assert_eq_str(said(cmsenv.decrypt_with_password(some_message(ok_shape), h("70"), 100000, None)), "cms: the signature, digest or tag did not verify")
    let odd_prf = algp(OID_PBKDF2, t(48, octh(zeros(8)) + inth(1000) + algp("1.2.3", "0500")))
    let bad_prf = pwri_hex(odd_prf, algp(OID_PWRI_KEK, algp(OID_AES128_CBC, octh(zeros(16)))))
    test.assert_eq_str(said(cmsenv.decrypt_with_password(some_message(bad_prf), h("70"), 100000, None)), "cms: algorithm 1.2.3 is not implemented")
    let zero_count = pwri_hex(algp(OID_PBKDF2, t(48, octh(zeros(8)) + inth(0))), algp(OID_PWRI_KEK, algp(OID_AES128_CBC, octh(zeros(16)))))
    test.assert_eq_str(said(cmsenv.decrypt_with_password(some_message(zero_count), h("70"), 100000, None)), "cms: unusable key: the iteration count is 0, the limit is 100000")

// A PasswordRecipientInfo from its two algorithm identifiers, version 0 and
// a 40-byte encrypted key; the key derivation algorithm is under [0].
fn pwri_hex(kdf: Str, wrap: Str) -> Str
    t(163, inth(0) + t(160, kdf_inner(kdf)) + wrap + octh(zeros(40)))

fn kdf_inner(kdf: Str) -> Str
    str.slice(kdf, 4, str.len(kdf))

@test
fn test_a_wrapped_key_with_wrong_check_octets() [io]
    // Build the plaintext of RFC 3211 section 2.3.1 by hand with the check
    // octets wrong, and encrypt it twice as the wrap does.
    let kek = counter(16, 1)
    let iv = counter(16, 9)
    let plain = h("10" + "000000" + hex(counter(16, 1)) + zeros(12))
    match cmscrypto.cbc_encrypt_raw(kek, iv, plain)
        Err(e)    => test.fail(e.message())
        Ok(pass1) =>
            match cmscrypto.cbc_encrypt_raw(kek, bytes.slice(pass1, 16, 32), pass1)
                Err(e)   => test.fail(e.message())
                Ok(wrap) => test.assert_eq_str(said(cmscrypto.pwri_unwrap(kek, iv, wrap)), "cms: the signature, digest or tag did not verify")

// ── SignedData ───────────────────────────────────────────────────────

fn signed_msg(inner: Str) -> Str
    wrapped(OID_SIGNED_DATA, inner)

fn data_eci() -> Str
    t(48, oidh(OID_DATA))

fn signer_hex(sid: Str, attrs: Str) -> Str
    t(48, inth(1) + sid + algh(OID_SHA256) + attrs + algh(OID_ECDSA_SHA256) + octh(zeros(8)))

fn sid_hex() -> Str
    t(48, "3000" + inth(1))

fn read_signed(hexed: Str) -> Str
    said(cmssigned.read(h(hexed)))

fn signed_of(b: Bytes) -> CmsSigned
    match cmssigned.read(b)
        Ok(s)  => s
        Err(e) =>
            test.fail(e.message())
            CmsSigned { version: 0, digest_algs: [], content_type: "", content: None, certs: [], crls: [], signers: [] }

fn with(sd: CmsSigned, s: CmsSigner) -> CmsSigned
    CmsSigned { version: sd.version, digest_algs: sd.digest_algs, content_type: sd.content_type, content: sd.content,
                certs: sd.certs, crls: sd.crls, signers: [s] }

fn like(s: CmsSigner, sig_alg: Str, digest_alg: Str, attrs_raw: ?Bytes, ski: Bytes, serial: Bytes, signature: Bytes) -> CmsSigner
    CmsSigner { version: s.version, issuer: s.issuer, serial: serial, ski: ski, digest_alg: digest_alg, attrs_raw: attrs_raw,
                attrs: s.attrs, sig_alg: sig_alg, sig_params: s.sig_params, signature: signature }

@test
fn test_signed_data_reader_refusals() [io]
    test.assert_eq_str(read_signed(signed_msg(inth(1) + t(49, "") + data_eci() + t(49, signer_hex("0500", "")))),
        "cms: malformed structure: the signer identifier")
    test.assert_eq_str(read_signed(signed_msg(inth(1) + t(49, "") + data_eci() + t(49, signer_hex(sid_hex(), t(160, t(48, oidh(OID_MESSAGE_DIGEST) + "0500")))))),
        "cms: malformed structure: the attribute values are a SET")
    test.case("revocation lists are kept")
    let with_crls = signed_msg(inth(1) + t(49, "") + data_eci() + t(161, "3000") + t(49, ""))
    match cmssigned.read(h(with_crls))
        Ok(sd) =>
            test.assert_eq(list.len(sd.crls), 1)
            test.assert_eq(list.len(sd.certs), 0)
        Err(e) => test.fail(e.message())

@test
fn test_signature_checks_with_changed_certificates() [io]
    let sd = signed_of(h(ec()))
    let s = sd.signers[0]
    test.case("a serial number with a leading zero still matches")
    let padded = with(sd, like(s, s.sig_alg, s.digest_alg, s.attrs_raw, s.ski, bytes.concat([h("00"), s.serial]), s.signature))
    test.assert_eq(cmssigned.find_certificate(padded, 0) == None, false)
    test.case("a signer that names its certificate by key identifier; a certificate without one; a malformed one")
    let by_key = with(sd, like(s, s.sig_alg, s.digest_alg, s.attrs_raw, h("3917b027f008ae25cef197b741e628dd9b7f7db7"), bytes.zeros(0), s.signature))
    test.assert_eq(cmssigned.find_certificate(by_key, 0) == None, false)
    let no_ski = CmsSigned { version: 1, digest_algs: sd.digest_algs, content_type: sd.content_type, content: sd.content,
                             certs: [h(cert_plain())], crls: [], signers: by_key.signers }
    test.assert_eq(cmssigned.find_certificate(no_ski, 0) == None, true)
    let bad_ski = CmsSigned { version: 1, digest_algs: sd.digest_algs, content_type: sd.content_type, content: sd.content,
                              certs: [h(malformed_ski())], crls: [], signers: by_key.signers }
    test.assert_eq(cmssigned.find_certificate(bad_ski, 0) == None, true)
    test.case("verification against keys that do not fit")
    test.assert_eq_str(said(cmssigned.verify(sd, 0, h(cert_p384()), None)), "cms: unusable key: the public key is not a P-256 point")
    test.assert_eq_str(said(cmssigned.verify(sd, 0, h(off_curve()), None)), "cms: unusable key: the public key is not a point of P-256")
    let sha1 = with(sd, like(s, s.sig_alg, OID_SHA1, None, s.ski, s.serial, s.signature))
    test.assert_eq_str(said(cmssigned.verify(sha1, 0, h(cert_ec()), None)), "cms: not implemented: ECDSA with a digest shorter than 256 bits")
    let rsa_signed = signed_of(h(rsa_pkcs1()))
    test.assert_eq_str(said(cmssigned.verify(rsa_signed, 0, h(cert_r1024()), None)), "cms: unusable key: rsa: the modulus is 1024 bits, below 2048")
    let rs = rsa_signed.signers[0]
    let sha1_rsa = with(rsa_signed, like(rs, OID_SHA1_WITH_RSA, OID_SHA1, None, bytes.zeros(0), rs.serial, rs.signature))
    test.assert_eq_str(said(cmssigned.verify(sha1_rsa, 0, h(cert_rsa()), None)),
        "cms: not implemented: RSA with the digest 1.3.14.3.2.26: rsa-nv verifies SHA-256 and SHA-384")
    let pss = signed_of(h(rsa_pss()))
    let no_mgf_params = t(48, t(160, algh(OID_SHA256)) + t(161, algh(OID_MGF1)) + t(162, inth(32)))
    match cmsder.root(h(no_mgf_params))
        Err(e)   => test.fail(e.message())
        Ok(node) =>
            let ps = pss.signers[0]
            let changed = CmsSigner { version: 1, issuer: ps.issuer, serial: ps.serial, ski: ps.ski, digest_alg: ps.digest_alg,
                                      attrs_raw: ps.attrs_raw, attrs: ps.attrs, sig_alg: ps.sig_alg, sig_params: Some(node), signature: ps.signature }
            test.assert_eq_str(said(cmssigned.verify(with(pss, changed), 0, h(cert_rsa()), None)), "cms: malformed structure: the MGF1 parameters")

fn malformed_ski() -> Str
    str.replace(cert_ec(), "0603551d0e04160414", "0603551d0e04160514")

// The certificate with one nibble of the public point's y changed, so that
// the point is no longer on the curve.
fn off_curve() -> Str
    let c = cert_ec()
    match str.index(c, "034200")
        None    => c
        Some(i) =>
            let at = i + 8 + 128 - 1
            str.slice(c, 0, at) + (if str.slice(c, at, at + 1) == "0" then "1" else "0") + str.slice(c, at + 1, str.len(c))

@test
fn test_ed25519_edges() [io]
    let msg = bytes.from_str("ed")
    let spec = CmsSignerSpec { cert: h(cert_ed()), scheme: 0, secret: h(ed_seed()), by_ski: false, signing_time: 0 - 1, attributes: false }
    match cmssigned.sign(msg, false, [spec])
        Err(e) => test.fail(e.message())
        Ok(b)  =>
            let sd = signed_of(b)
            let s = sd.signers[0]
            test.assert_eq_str(said(cmssigned.verify(sd, 0, h(cert_ed()), None)), "ok")
            test.case("a signature of the wrong length; one that is not a signature; one over other content")
            let short = with(sd, like(s, s.sig_alg, s.digest_alg, s.attrs_raw, s.ski, s.serial, h("0102")))
            test.assert_eq_str(said(cmssigned.verify(short, 0, h(cert_ed()), None)), "cms: the signature, digest or tag did not verify")
            let ones = with(sd, like(s, s.sig_alg, s.digest_alg, s.attrs_raw, s.ski, s.serial, bytes.fill(bytes.zeros(64), 0, 64, 255)))
            test.assert_eq_str(said(cmssigned.verify(ones, 0, h(cert_ed()), None)), "cms: the signature, digest or tag did not verify")
            let other = CmsSigned { version: sd.version, digest_algs: sd.digest_algs, content_type: sd.content_type,
                                    content: Some(bytes.from_str("xx")), certs: sd.certs, crls: sd.crls, signers: sd.signers }
            test.assert_eq_str(said(cmssigned.verify(other, 0, h(cert_ed()), None)), "cms: the signature, digest or tag did not verify")
            test.case("keys that do not fit")
            test.assert_eq_str(starts(said(cmssigned.verify(sd, 0, h(cert_ec()), None)), "cms: unusable key"), "yes")
            test.assert_eq_str(said(cmssigned.verify(sd, 0, h(small_order_ed()), None)), "cms: unusable key: the public key is not an acceptable Ed25519 key")

fn starts(s: Str, prefix: Str) -> Str
    if str.starts_with(s, prefix)
        "yes"
    else
        s

// The Ed25519 certificate with its public key replaced by the identity
// point, which has order 1.
fn small_order_ed() -> Str
    let c = cert_ed()
    match str.index(c, "032100")
        None    => c
        Some(i) => str.slice(c, 0, i + 6) + "01" + str.repeat("00", 31) + str.slice(c, i + 6 + 64, str.len(c))

@test
fn test_signing_with_certificates_that_cannot_name_a_key() [io]
    let msg = bytes.from_str("x")
    let plain = CmsSignerSpec { cert: h(cert_plain()), scheme: 1, secret: h(ec_scalar()), by_ski: true, signing_time: 0 - 1, attributes: true }
    test.assert_eq_str(said(cmssigned.sign(msg, false, [plain])), "cms: unusable key: the certificate has no subject key identifier")
    let bad = CmsSignerSpec { cert: h(malformed_ski()), scheme: 1, secret: h(ec_scalar()), by_ski: true, signing_time: 0 - 1, attributes: true }
    test.assert_eq_str(starts(said(cmssigned.sign(msg, false, [bad])), "cms: unusable key"), "yes")
